// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String

  // ── Profile fields ───────────────────────────────
  name       String?         // optional until user fills it
  birthdate  DateTime?       // optional
  role      UserRole @default(USER)         // 'organizer' or 'participant'
  // ─────────────────────────────────────────────────

  // ── Preferences ──────────────────────────────────
  experienceLevel       String?  // Beginner, Intermediate, Expert
  preferredDifficulty   String?  // Easy, Moderate, Hard
  preferredTrailType    String?  // e.g., Forest, Summit
  preferredDurationHrs  Float?   // hours
  budgetRange           String?  // e.g., $50-$100
  // ─────────────────────────────────────────────────

  createdAt  DateTime @default(now())
}

enum UserRole {
  USER
  ADMIN
}
