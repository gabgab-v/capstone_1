generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  password                String?
  supabaseUserId          String?   @unique

  name                    String?
  birthdate               DateTime?
  gcashNumber             String?
  avatarUrl               String?
  bio                     String?
  role                    UserRole  @default(USER)
  organizerRequestPending Boolean   @default(false)

  experienceLevel         String?
  experienceLevelLocked   Boolean   @default(false)
  expertBadgeAwarded      Boolean   @default(false)
  expertVerifiedAt        DateTime?
  preferredDifficulty     String?
  preferredTrailType      String?
  preferredDurationHrs    Float?
  preferredDistanceKm     Float?
  preferredElevationM     Float?
  budgetRange             String?

  bookings                Booking[]
  events                  Event[]
  trails                  Trail[]
  posts                   Post[]
  postLikes               PostLike[]
  postComments            PostComment[]
  eventComments           EventComment[]
  organizerApplication    OrganizerApplication?
  reviewedOrganizerApplications OrganizerApplication[] @relation("OrganizerApplicationReviewer")
  expertApplication       ExpertApplication?
  reviewedExpertApplications ExpertApplication[] @relation("ExpertApplicationReviewer")
  followers               Follow[] @relation("FollowedUser")
  following               Follow[] @relation("FollowingUser")
  conversations           ConversationParticipant[]
  messages                Message[]
  organizerReviewsReceived OrganizerReview[] @relation("OrganizerReviewsReceived")
  organizerReviewsGiven   OrganizerReview[] @relation("OrganizerReviewsGiven")

  createdAt               DateTime  @default(now())
}

model Event {
  id                   String   @id @default(uuid())
  title                String
  overview             String?
  itinerary            String?
  directions           String?
  distanceKm           Float?
  durationHrs          Float?
  startsAt             DateTime?
  endsAt               DateTime?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  steps                Int?
  elevationM           Float?
  price                Int      @default(0)
  imageUrl             String?
  difficulty           EventDifficulty @default(BEGINNER)
  minParticipants      Int      @default(0)
  maxParticipants      Int?
  status               EventStatus     @default(PUBLISHED)
  completedAt          DateTime?

  announceAt           DateTime?

  locationName         String?
  locationLatitude     Float?
  locationLongitude    Float?
  locationZoomLevel    Float?
  locationBounds       Json?
  trailId              String?
  trail                Trail?   @relation(fields: [trailId], references: [id])
  trailGeoJson         Json?
  trailDistanceMeters  Float?

  organizer            User     @relation(fields: [organizerId], references: [id])
  gcashNumber          String?
  organizerId          String
  bookings             Booking[]
  comments             EventComment[]
  conversations        Conversation[]

  createdAt            DateTime @default(now())

  @@index([trailId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
  CANCELLED
}

model Booking {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  event       Event    @relation(fields: [eventId], references: [id])
  eventId     String
  status      String   @default("PENDING")
  paymentUrl  String?
  totalAmount Float
  createdAt   DateTime @default(now())
}

model Trail {
  id                  String   @id @default(uuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  label               String?
  startedAt           DateTime
  endedAt             DateTime?
  totalDistanceMeters Float    @default(0)
  geoJson             Json
  samples             Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  events              Event[]

  @@index([userId, startedAt])
}

model Post {
  id        String   @id @default(uuid())
  content   String?
  imageUrls String[] @default([])
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     PostLike[]
  comments  PostComment[]

  @@index([userId, createdAt])
}

enum UserRole {
  USER
  ADMIN
  ORGANIZER
}

enum EventDifficulty {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpertApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrganizerApplication {
  id                   String                      @id @default(uuid())
  user                 User                        @relation(fields: [userId], references: [id])
  userId               String                      @unique
  legalName            String
  organizationName     String?
  certifications       String?
  governmentIdNumber   String?
  experienceYears      Int?
  bio                  String?
  documentUrls         String[]                    @default([])
  additionalNotes      String?
  status               OrganizerApplicationStatus  @default(PENDING)
  reviewer             User?                       @relation("OrganizerApplicationReviewer", fields: [reviewerId], references: [id])
  reviewerId           String?
  reviewNotes          String?
  reviewedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
}

model ExpertApplication {
  id             String                   @id @default(uuid())
  user           User                     @relation(fields: [userId], references: [id])
  userId         String                   @unique
  summitName     String
  summitDate     DateTime?
  peakPhotoUrl   String
  certificateUrl String
  additionalNotes String?
  status         ExpertApplicationStatus  @default(PENDING)
  reviewer       User?                    @relation("ExpertApplicationReviewer", fields: [reviewerId], references: [id])
  reviewerId     String?
  reviewNotes    String?
  reviewedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model Follow {
  id           String   @id @default(uuid())
  follower     User     @relation("FollowingUser", fields: [followerId], references: [id])
  followerId   String
  following    User     @relation("FollowedUser", fields: [followingId], references: [id])
  followingId  String
  createdAt    DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model PostLike {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  content   String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([userId])
}

model Conversation {
  id           String                    @id @default(uuid())
  event        Event?                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String?                   @unique
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String        @id @default(uuid())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime      @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model OrganizerReview {
  id          String   @id @default(uuid())
  organizer   User     @relation("OrganizerReviewsReceived", fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId String
  reviewer    User     @relation("OrganizerReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId  String
  rating      Int
  feedback    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizerId, reviewerId])
  @@index([organizerId])
  @@index([reviewerId])
}

model EventComment {
  id        String   @id @default(uuid())
  content   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, createdAt])
  @@index([userId])
}
