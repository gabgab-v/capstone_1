// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String

  // ── Profile fields ───────────────────────────────
  name       String?         // optional until user fills it
  birthdate  DateTime?       // optional
  role      UserRole @default(USER)         // 'organizer' or 'participant'
  // ─────────────────────────────────────────────────
  organizerRequestPending Boolean @default(false)
  // ── Preferences ──────────────────────────────────
  experienceLevel       String?  // Beginner, Intermediate, Expert
  preferredDifficulty   String?  // Easy, Moderate, Hard
  preferredTrailType    String?  // e.g., Forest, Summit
  preferredDurationHrs  Float?   // hours
  budgetRange           String?  // e.g., $50-$100
  // ─────────────────────────────────────────────────
  events     Event[] 
  
  createdAt  DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  distanceKm  Float?
  durationHrs Float?
  steps       Int?
  elevationM  Float?

  organizer   User     @relation(fields: [organizerId], references: [id])
  organizerId String

  createdAt   DateTime @default(now())
}


enum UserRole {
  USER
  ADMIN
  ORGANIZER
}
