// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String

  // ── Profile fields ───────────────────────────────
  name       String?         // optional until user fills it
  birthdate  DateTime?       // optional
  gcashNumber String?
  role      UserRole @default(USER)         // 'organizer' or 'participant' 
  bookings  Booking[]  // events booked
  // ─────────────────────────────────────────────────
  organizerRequestPending Boolean @default(false)
  // ── Preferences ──────────────────────────────────
  experienceLevel       String?  // Beginner, Intermediate, Expert
  preferredDifficulty   String?  // Easy, Moderate, Hard
  preferredTrailType    String?  // e.g., Forest, Summit
  preferredDurationHrs  Float?   // hours
  budgetRange           String?  // e.g., $50-$100
  // ─────────────────────────────────────────────────
  events     Event[] 
  
  createdAt  DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  overview    String?
  itinerary   String?
  directions  String?
  distanceKm  Float?
  durationHrs Float?
  steps       Int?
  elevationM  Float?
  price       Int      @default(0)
  imageUrl    String? 

  organizer   User     @relation(fields: [organizerId], references: [id])
  gcashNumber String?   // ? makes it nullable
  organizerId String
  bookings    Booking[]

  createdAt   DateTime @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  event       Event    @relation(fields: [eventId], references: [id])
  eventId     String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  paymentUrl  String?  // optional: GCash screenshot / receipt file URL
  totalAmount Float
  createdAt   DateTime @default(now())
}


enum UserRole {
  USER
  ADMIN
  ORGANIZER
}
